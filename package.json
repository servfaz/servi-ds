{
  "name": "registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/sync-registry-tokens.cjs",
    "build": "node -e \"console.log('DEBUG registry.json items:', JSON.stringify(require('./registry.json').items.map(i => ({ name: i.name, type: i.type, hasCssVars: !!i.cssVars }))))\" && shadcn build && next build",
    "start": "next start",
    "lint": "next lint",
    "sync-tokens": "node scripts/sync-registry-tokens.cjs",
    "registry:build": "npm run sync-tokens && shadcn build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/unist": "^3.0.3",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  }
}
